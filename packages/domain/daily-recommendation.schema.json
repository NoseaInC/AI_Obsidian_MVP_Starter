{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixu.local/schema/daily-recommendation-v1.json",
  "title": "DailyRecommendation",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "category", "estimatedMinutes", "route", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "category": {"enum": ["review", "learn", "daily-knowledge", "explore", "source"]},
    "estimatedMinutes": {"type": "integer", "minimum": 1, "maximum": 240},
    "route": {"enum": ["mainline", "branch"]},
    "reason": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verificationGrade": {"enum": ["A", "B", "C"]}
  },
  "additionalProperties": true
}
