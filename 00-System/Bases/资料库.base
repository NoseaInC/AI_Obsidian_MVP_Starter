filters:
  and:
    - 'file.ext == "md"'
    - 'type == "source"'
properties:
  file.name:
    displayName: 资料
  source_type:
    displayName: 类型
  status:
    displayName: 状态
  original_location:
    displayName: 原始位置
  processed_by:
    displayName: 处理模型
  processed_at:
    displayName: 处理时间
  related_concepts:
    displayName: 相关概念
  source_id:
    displayName: 来源 ID
  ai_draft:
    displayName: 整理草稿
views:
  - type: table
    name: 待处理
    filters:
      and:
        - 'status == "inbox"'
    order:
      - file.name
      - source_type
      - status
      - original_location
      - created
  - type: table
    name: 已处理
    filters:
      and:
        - 'status == "processed" || status == "reviewed"'
    order:
      - file.name
      - source_type
      - status
      - processed_by
      - processed_at
      - ai_draft
      - related_concepts
